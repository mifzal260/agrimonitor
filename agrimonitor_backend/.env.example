APP_NAME=AgriMonitor API
APP_ENV=local
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agrimonitor
JWT_SECRET_KEY=change-this-secret-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_ROTATION_ENABLED=true
REFRESH_TOKEN_REUSE_DETECTION_ENABLED=true
MAX_ACTIVE_SESSIONS_PER_USER=10
SESSION_CLEANUP_BATCH_SIZE=500
ALLOW_LEGACY_ACCESS_TOKENS=true
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=300
LOGIN_MAX_ATTEMPTS_PER_IP=15
LOGIN_IP_WINDOW_SECONDS=900
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=1800
REGISTRATION_RATE_LIMIT_ENABLED=true
REGISTRATION_MAX_ATTEMPTS_PER_EMAIL=5
REGISTRATION_EMAIL_WINDOW_SECONDS=1800
REGISTRATION_MAX_ATTEMPTS_PER_IP=10
REGISTRATION_IP_WINDOW_SECONDS=3600
LOGIN_PROTECTION_STORE=memory
LOGIN_PROTECTION_FAIL_MODE=closed
REDIS_URL=
REDIS_KEY_PREFIX=agrimonitor:login-protection
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=20
TRUSTED_PROXY_IPS=
IOT_DATA_MODE=simulation
IOT_ONLINE_AFTER_SECONDS=600
IOT_OFFLINE_AFTER_SECONDS=3600
IOT_TEMPERATURE_WARNING_CELSIUS=35
IOT_SOIL_MOISTURE_WARNING_PERCENT=30
IOT_BATTERY_WARNING_PERCENT=20
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.4
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=400
